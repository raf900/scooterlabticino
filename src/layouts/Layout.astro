---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site, wa } from '../data/site.js';

const nav = [['/riparazioni', 'Riparazioni'], ['/usato', 'Usato'], ['/contatti', 'Contatti']];
const path = Astro.url.pathname;
const { title =`${site.name} — ${site.tagline}`, description = 'Riparazione, manutenzione e vendita di monopattini elettrici usati in Ticino. Diagnosi rapida, preventivi chiari, ricambi di qualità.' } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_CH" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <Logo />
        <nav>
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <a class="btn btn-sm" href={wa('Ciao ScooterLab! Vorrei informazioni.')}>WhatsApp</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>scooterlabticino.ch</span>
      </div>
    </footer>
  </body>
</html>
