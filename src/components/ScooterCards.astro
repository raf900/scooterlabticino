---
import { Image } from 'astro:assets';
import ScooterMark from './ScooterMark.astro';
import { scooters, statusLabel, chf } from '../data/site.js';
import { photo } from '../data/photos.js';

// exclude: slug da non mostrare (es. il monopattino della pagina corrente)
// onlyAvailable: mostra solo quelli 'disponibile' (usato in home)
const { exclude, onlyAvailable = false } = Astro.props;
const list = scooters.filter((s) => s.slug !== exclude && (!onlyAvailable || s.status === 'disponibile'));
---
{list.length === 0 && <p class="sub">Al momento non ci sono monopattini disponibili. <a href="/usato">Guarda quelli in arrivo</a>.</p>}
<div class="grid grid-3">
  {list.map((s) => {
    const img = photo(s.photos?.[0]);
    const href = `/usato/${s.slug}`;
    return (
      <article class="card scooter">
        <a href={href} class={img ? 'scooter-img has-photo' : 'scooter-img'} aria-label={s.model}>
          {img
            ? <Image src={img} alt={s.model} widths={[320, 640]} sizes="(max-width: 600px) 90vw, 340px" />
            : <ScooterMark />}
          {s.status && <span class={`status status-${s.status}`}>{statusLabel[s.status]}</span>}
        </a>
        <h3><a href={href} class="scooter-link">{s.model}</a></h3>
        <ul class="specs">
          {s.year && <li>{s.year}</li>}
          {s.km != null && <li>{s.km.toLocaleString('de-CH')} km</li>}
          <li>{s.speed}</li>
          {s.condition && <li>{s.condition}</li>}
        </ul>
        <div class="scooter-foot">
          <span class="big-price">{chf(s.price)}</span>
          <a class="btn btn-sm" href={href}>Dettagli</a>
        </div>
      </article>
    );
  })}
</div>
