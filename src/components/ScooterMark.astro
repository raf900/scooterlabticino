---
// Marchio Scooter Lab: il monopattino dell'illustrazione con il fulmine blu.
import { scooterViewBox, scooterPaths } from '../data/scooterArt.js';

const { class: className, ...rest } = Astro.props;
---
<svg class:list={['sc-art', className]} viewBox={scooterViewBox.join(' ')} aria-hidden="true" {...rest}>
  {scooterPaths.map((p) => <path d={p.d} class={p.tone} />)}
  <path d="M585 880 515 1010h45l-25 110 95-150h-48z" class="sc-bolt" />
</svg>
