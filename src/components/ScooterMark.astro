---
// Marchio Scooter Lab: lo stesso monopattino dello schema riparazioni, in blu, con scie di velocità.
import { scooterPaths } from '../data/scooterArt.js';

const { class: className, ...rest } = Astro.props;

// Scie: [y, x inizio, x fine, mezzo spessore] — rastremate, con l'estremo arrotondato vicino al piantone.
const streak = ([y, x0, x1, h]) => `M${x0} ${y - h}L${x1} ${y - 1.5}a1.5 1.5 0 0 1 0 3L${x0} ${y + h}a${h} ${h} 0 0 1 0 ${-2 * h}Z`;
const streaks = [[835, 435, 735, 15], [935, 415, 640, 12], [1035, 392, 565, 9]];

// id univoco: il marchio compare più volte nella stessa pagina.
const gid = `sm-grad-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class:list={['logo-mark', 'sm-blue', className]} viewBox="222 730 525 555" aria-hidden="true" {...rest}>
  <defs>
    <linearGradient id={gid} gradientUnits="userSpaceOnUse" x1="390" y1="0" x2="740" y2="0">
      <stop offset="0" stop-color="var(--accent)" />
      <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
    </linearGradient>
  </defs>
  {streaks.map((s) => <path d={streak(s)} fill={`url(#${gid})`} />)}
  {scooterPaths.map((p) => <path d={p.d} class={p.tone} />)}
</svg>

<style>
  /* Stessi toni blu della zona selezionata nello schema riparazioni. */
  .sm-blue .t1 { fill: #d4e7ff; }
  .sm-blue .t2 { fill: #a3ccff; }
  .sm-blue .t3 { fill: #63aaff; }
  .sm-blue .t4 { fill: #2f8fff; }
  .sm-blue .t5 { fill: #1d66c4; }
  .sm-blue .t6 { fill: #164c92; }
  .sm-blue .r { fill: #ff4d5e; }
  .sm-blue .r2 { fill: #c23040; }
</style>
