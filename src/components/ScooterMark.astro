---
// Marchio Scooter Lab: il monopattino dello schema riparazioni, tutto blu e un po' più spesso, con scie di velocità.
import { scooterPaths } from '../data/scooterArt.js';

const { class: className, ...rest } = Astro.props;

// Tutto tranne il cavo del freno (path 0).
const body = scooterPaths.filter((_, i) => i !== 0).map((p) => p.d);
const wheels = [[282, 1225], [678, 1225]];

// Scie: partono appena dietro il piantone seguendone l'inclinazione, lunghezze e spessori diversi,
// alcune finiscono con un trattino staccato.
const stemX = (y) => 400 - (y - 744) * 0.249;
const rows = [
  { y: 815, w: 18, len: 250, dash: 40 },
  { y: 865, w: 13, len: 185, dash: 0 },
  { y: 915, w: 18, len: 285, dash: 50 },
  { y: 965, w: 12, len: 160, dash: 28 },
  { y: 1015, w: 16, len: 220, dash: 0 },
  { y: 1065, w: 11, len: 135, dash: 24 },
];
const lines = rows.flatMap(({ y, w, len, dash }) => {
  const x0 = stemX(y) + 42, x1 = x0 + len;
  const segs = [{ d: `M${x0} ${y}H${x1}`, w, o: 1 }];
  if (dash) segs.push({ d: `M${x1 + w + 10} ${y}h${dash}`, w, o: 0.55 });
  return segs;
});

// id univoci: il marchio compare più volte nella stessa pagina.
const mid = `sm-mask-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class:list={['logo-mark', className]} viewBox="220 728 560 562" aria-hidden="true" {...rest}>
  <defs>
    <mask id={mid} maskUnits="userSpaceOnUse" x="200" y="700" width="620" height="620">
      <rect x="200" y="700" width="620" height="620" fill="#fff" />
      {wheels.map(([cx, cy]) => <circle cx={cx} cy={cy} r="37" fill="#000" />)}
      {wheels.map(([cx, cy]) => <circle cx={cx} cy={cy} r="13" fill="#fff" />)}
    </mask>
  </defs>
  <g class="sm-lines">
    {lines.map((l) => <path d={l.d} stroke-width={l.w} opacity={l.o} />)}
  </g>
  <g class="sm-body" mask={`url(#${mid})`}>
    {body.map((d) => <path d={d} />)}
  </g>
</svg>
