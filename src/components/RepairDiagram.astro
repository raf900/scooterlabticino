---
import { site, zones } from '../data/site.js';
import { scooterViewBox, scooterPaths } from '../data/scooterArt.js';

const initial = 'completo';
const wa = (text) => `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(text)}`;

// Lo schema usa un viewBox 640×520; l'illustrazione viene scalata e centrata dentro.
const W = 640, H = 520;
const [vx, vy, vw, vh] = scooterViewBox;
const s = 440 / vh;
const art = `translate(${(W - vw * s) / 2} 40) scale(${s}) translate(${-vx} ${-vy})`;

// Marcatori numerati e linee guida [x1 y1 x2 y2], nelle coordinate del viewBox.
// Due colonne alla stessa altezza: 1–3 a sinistra dall'alto in basso, 4–6 a destra sopra la ruota dietro dal basso in alto.
const markers = {
  volante: [64, 60],
  scocca: [64, 200],
  davanti: [64, 340],
  dietro: [576, 340],
  elettronica: [576, 200],
  completo: [576, 60],
};
const leads = {
  volante: [86, 60, 182, 60],
  scocca: [86, 200, 206, 200],
  davanti: [80, 356, 120, 404],
  dietro: [560, 356, 507, 405],
  elettronica: [556, 212, 360, 428],
};
const cls = (id) => `zone ${id === initial || initial === 'completo' ? 'active' : ''}`;
---
<div class="dg" data-diagram data-default={initial}>
  <div class="dg-figure">
    <svg class="dg-svg sc-art" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      <ellipse cx="320" cy="484" rx="230" ry="8" class="dg-floor" />

      <g class={cls('completo')} data-zone="completo">
        <rect x="16" y="16" width="608" height="488" rx="28" class="dg-frame" />
      </g>

      {Object.entries(leads).map(([id, [x1, y1, x2, y2]]) => (
        <g class={cls(id)} data-zone={id}>
          <path d={`M${x1} ${y1} ${x2} ${y2}`} class="dg-lead" />
        </g>
      ))}

      <g transform={art}>
        {zones.filter((z) => z.id !== 'completo').map((z) => (
          <g class={cls(z.id)} data-zone={z.id}>
            {scooterPaths.filter((p) => p.zone === z.id).map((p) => <path d={p.d} class={p.tone} />)}
          </g>
        ))}
      </g>
    </svg>

    {zones.map((z, i) => (
      <button
        type="button"
        class="dg-marker"
        data-pick={z.id}
        aria-pressed={String(z.id === initial)}
        aria-label={z.title}
        style={`left:${(markers[z.id][0] / W) * 100}%;top:${(markers[z.id][1] / H) * 100}%`}
      >{i + 1}</button>
    ))}
  </div>

  <div class="dg-panel card">
    <div class="dg-stack">
    {zones.map((z, i) => (
      <div class="dg-info" data-panel={z.id} aria-hidden={String(z.id !== initial)}>
        <h3><span class="dg-num">{i + 1}</span>{z.title}</h3>
        <p>{z.text}</p>
        <ul class="dg-parts">
          {z.parts.map((p) => <li>{p}</li>)}
        </ul>
        <div class="dg-foot">
          <span class="dg-price">{z.price}</span>
          <a class="btn btn-sm" href={wa(`Ciao! Ho un problema a: ${z.title.toLowerCase()}. Posso avere un preventivo?`)}>Prenota su WhatsApp</a>
        </div>
      </div>
    ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-diagram]').forEach((root) => {
    const select = (id: string) => {
      // Il check-up completo accende tutto il monopattino, cornice compresa.
      root.querySelectorAll<HTMLElement>('[data-zone]').forEach((el) => el.classList.toggle('active', id === 'completo' || el.dataset.zone === id));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => el.setAttribute('aria-hidden', String(el.dataset.panel !== id)));
      root.querySelectorAll<HTMLElement>('[data-pick]').forEach((el) => el.setAttribute('aria-pressed', String(el.dataset.pick === id)));
    };
    root.querySelectorAll<HTMLElement>('[data-pick], svg [data-zone]').forEach((el) => {
      const id = (el.dataset.pick ?? el.dataset.zone)!;
      el.addEventListener('click', () => select(id));
      el.addEventListener('mouseenter', () => select(id));
    });
  });
</script>

<style>
  .dg { display: grid; grid-template-columns: 1.55fr 1fr; gap: 32px; align-items: center; margin-top: 2rem; }
  .dg-figure { position: relative; }
  .dg-svg { display: block; width: 100%; height: auto; }
  .dg-floor { fill: rgb(47 143 255 / .12); }

  .zone { cursor: pointer; transition: opacity .25s, filter .25s; }
  .zone path { transition: fill .25s, stroke .25s; }
  .dg:has(.zone.active) .zone:not(.active) { opacity: .35; }
  .zone.active { filter: drop-shadow(0 0 8px rgb(47 143 255 / .6)); }
  /* Zona attiva: stessi toni dell'illustrazione, in blu. */
  .zone.active .t1 { fill: #d4e7ff; }
  .zone.active .t2 { fill: #a3ccff; }
  .zone.active .t3 { fill: #63aaff; }
  .zone.active .t4 { fill: #2f8fff; }
  .zone.active .t5 { fill: #1d66c4; }
  .zone.active .t6 { fill: #164c92; }
  /* Tema chiaro: blu dal più scuro al più chiaro */
  :global([data-theme='light']) .zone.active .t1 { fill: #0e3a7a; }
  :global([data-theme='light']) .zone.active .t2 { fill: #1653b0; }
  :global([data-theme='light']) .zone.active .t3 { fill: #1a6fe0; }
  :global([data-theme='light']) .zone.active .t4 { fill: #5ea4ff; }
  :global([data-theme='light']) .zone.active .t5 { fill: #a3ccff; }
  :global([data-theme='light']) .zone.active .t6 { fill: #d4e7ff; }
  .dg-lead { fill: none; stroke: var(--muted); stroke-width: 1.5; stroke-dasharray: 3 5; stroke-linecap: round; }
  .dg-frame { fill: none; stroke: var(--frame); stroke-width: 2.5; stroke-dasharray: 2 9; stroke-linecap: round; pointer-events: none; }
  .zone.active :is(.dg-frame, .dg-lead) { stroke: var(--accent); }

  .dg-marker {
    position: absolute; transform: translate(-50%, -50%);
    width: 44px; height: 44px; border-radius: 50%;
    border: 2px solid var(--accent); background: var(--bg); color: var(--text);
    font: 800 1.15rem var(--display); cursor: pointer;
    transition: background .2s, box-shadow .2s, transform .2s;
  }
  /* Area di tocco invisibile più grande del cerchio. */
  .dg-marker::before { content: ''; position: absolute; inset: -10px; border-radius: 50%; }
  .dg-marker:hover, .dg-marker[aria-pressed='true'] {
    background: var(--accent); color: #fff; box-shadow: 0 0 0 6px rgb(47 143 255 / .2), 0 0 24px var(--accent);
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* Tutti i pannelli nella stessa cella: il box prende l'altezza del più lungo e non cambia dimensione. */
  .dg-stack { display: grid; }
  .dg-info { grid-area: 1 / 1; display: flex; flex-direction: column; transition: opacity .2s; }
  .dg-info[aria-hidden='true'] { visibility: hidden; opacity: 0; }
  .dg-info .dg-foot { margin-top: auto; }
  .dg-info h3 { display: flex; align-items: center; gap: 12px; font-size: 1.35rem; }
  .dg-num { display: grid; place-items: center; flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 1rem; box-shadow: 0 0 20px -4px var(--accent); }
  .dg-parts { list-style: none; padding: 0; margin: 0 0 22px; display: flex; flex-wrap: wrap; gap: 6px; }
  .dg-parts li { font-size: .82rem; color: var(--text); border: 1px solid var(--line); border-radius: 999px; padding: 3px 11px; }
  .dg-parts li::before { content: '✓ '; color: var(--accent); }
  .dg-foot { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .dg-price { font-family: var(--display); font-weight: 800; font-size: 1.4rem; color: var(--accent); }

  @media (max-width: 900px) {
    .dg { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .dg-marker { width: 36px; height: 36px; font-size: 1rem; }
    .dg-info { text-align: center; }
    .dg-info h3, .dg-parts, .dg-foot { justify-content: center; }
    .dg-foot { flex-direction: column; }
  }
</style>
