---
// Interruttore tema animato, versione compatta: notte (luna + stelle) ↔ giorno (sole + nuvola).
// Lo stato visivo segue [data-theme] su <html>; il click è gestito nel Layout ([data-theme-toggle]).
const { class: className } = Astro.props;
---
<button type="button" class:list={['tt', className]} aria-label="Tema chiaro" aria-pressed="false" data-theme-toggle>
  <span class="tt-stars" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="tt-cloud" aria-hidden="true"></span>
  <span class="tt-knob" aria-hidden="true"></span>
</button>

<style is:global>
  .tt {
    --tt-w: 40px; --tt-h: 22px; --tt-k: 16px; --tt-night: #15244a;
    position: relative; flex-shrink: 0; width: var(--tt-w); height: var(--tt-h); padding: 0;
    border: 1px solid var(--line); border-radius: 999px; overflow: hidden; cursor: pointer;
    background: #101c3a;
  }
  .tt:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  /* cielo di giorno in dissolvenza sopra quello notturno */
  .tt::before { content: ''; position: absolute; inset: 0; background: #6fb3ff; opacity: 0; transition: opacity .4s ease; }

  /* stelle (notte) */
  .tt-stars i {
    position: absolute; width: 2px; height: 2px; border-radius: 50%; background: #fff;
    transition: opacity .3s, transform .4s ease;
    animation: tt-twinkle 2.4s ease-in-out infinite alternate;
  }
  .tt-stars i:nth-child(1) { left: 6px; top: 5px; }
  .tt-stars i:nth-child(2) { left: 11px; top: 12px; animation-delay: .8s; }
  .tt-stars i:nth-child(3) { left: 16px; top: 5px; width: 1.5px; height: 1.5px; animation-delay: 1.6s; }
  @keyframes tt-twinkle { from { opacity: .35; } to { opacity: 1; } }

  /* nuvola (giorno) */
  .tt-cloud {
    position: absolute; right: 5px; top: 9px; width: 10px; height: 4px; border-radius: 999px; background: #fff;
    opacity: 0; transform: translateX(10px); transition: opacity .35s, transform .5s cubic-bezier(.2, .8, .2, 1);
  }
  .tt-cloud::before { content: ''; position: absolute; left: 2px; bottom: 1.5px; width: 5px; height: 5px; border-radius: 50%; background: inherit; }

  /* pomello: luna a destra (notte) → sole a sinistra (giorno) */
  .tt-knob {
    position: absolute; z-index: 1; top: 2px; left: calc(var(--tt-w) - 2px - var(--tt-k) - 2px);
    width: var(--tt-k); height: var(--tt-k); border-radius: 50%; overflow: hidden;
    background: #e9eef8;
    transition: left .5s cubic-bezier(.68, -.35, .27, 1.35), background .4s, box-shadow .4s, transform .5s ease;
  }
  /* ombra che crea la falce di luna */
  .tt-knob::after {
    content: ''; position: absolute; width: 100%; height: 100%; border-radius: 50%;
    top: -2px; left: -6px; background: var(--tt-night);
    transition: transform .4s ease, opacity .25s;
  }

  [data-theme='light'] .tt::before { opacity: 1; }
  [data-theme='light'] .tt-stars i { opacity: 0; transform: translateY(10px); animation: none; }
  [data-theme='light'] .tt-cloud { opacity: .95; transform: none; }
  [data-theme='light'] .tt-knob { left: 2px; transform: rotate(-180deg); background: #ffd84d; box-shadow: 0 0 5px rgb(255 196 40 / .8); }
  [data-theme='light'] .tt-knob::after { transform: translate(-12px, -9px) scale(.3); opacity: 0; }

  /* Con JavaScript attivo l'animazione la fa lo script qui sotto: niente transizioni CSS che si sovrappongono. */
  .tt.tt-js::before, .tt.tt-js *, .tt.tt-js *::before, .tt.tt-js *::after { transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .tt *, .tt::before, .tt *::before, .tt *::after { transition: none !important; animation: none !important; }
  }
</style>

<script>
  // Animazione giorno ↔ notte. Il Layout cambia [data-theme] e lancia l'evento 'themechange':
  // qui si anima dal vecchio al nuovo stato (lo stato finale lo dà già il CSS).
  const SUN = '#ffd84d', MOON = '#e9eef8';
  const GLOW = '0 0 5px rgb(255 196 40 / .8)', NO_GLOW = '0 0 0 rgb(255 196 40 / 0)';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  const toggles = document.querySelectorAll<HTMLElement>('.tt');
  toggles.forEach((t) => t.classList.add('tt-js'));

  function play(t: HTMLElement, toNight: boolean) {
    const knob = t.querySelector<HTMLElement>('.tt-knob')!;
    const cloud = t.querySelector<HTMLElement>('.tt-cloud')!;
    const stars = t.querySelectorAll<HTMLElement>('.tt-stars i');
    const travel = t.clientWidth - knob.offsetWidth - 4;   // distanza tra le due posizioni del pomello
    const from = toNight ? -travel : travel;                // il CSS ha già spostato il pomello alla fine
    const ease = 'cubic-bezier(.45, 0, .25, 1)';

    // il sole/luna viaggia su un piccolo arco, ruotando
    knob.animate([
      // angoli coerenti con il CSS a riposo: giorno = rotate(-180deg), notte = nessuna rotazione
      { transform: `translate(${from}px, 0) rotate(${toNight ? -180 : 0}deg)`, background: toNight ? SUN : MOON, boxShadow: toNight ? GLOW : NO_GLOW },
      { transform: `translate(${from / 2}px, -3px) rotate(-90deg)`, offset: 0.5 },
      { transform: `translate(0, 0) rotate(${toNight ? 0 : -180}deg)`, background: toNight ? MOON : SUN, boxShadow: toNight ? NO_GLOW : GLOW },
    ], { duration: 650, easing: ease });

    // l'ombra della falce entra (verso notte) o esce (verso giorno) a metà corsa
    const shadowOff = { transform: 'translate(-12px, -9px) scale(.3)', opacity: 0 };
    const shadowOn = { transform: 'none', opacity: 1 };
    knob.animate(toNight ? [shadowOff, shadowOff, shadowOn] : [shadowOn, shadowOff, shadowOff],
      { duration: 650, easing: ease, pseudoElement: '::after' });

    // cielo: azzurro ↔ blu notte
    t.animate([{ opacity: toNight ? 1 : 0 }, { opacity: toNight ? 0 : 1 }],
      { duration: 550, easing: 'ease', pseudoElement: '::before' });

    // nuvola: se ne va verso destra / torna
    const cloudIn = { opacity: 0.95, transform: 'none' }, cloudOut = { opacity: 0, transform: 'translateX(10px)' };
    cloud.animate(toNight ? [cloudIn, cloudOut] : [cloudOut, cloudIn],
      { duration: 400, delay: toNight ? 0 : 300, easing: 'cubic-bezier(.2, .8, .2, 1)', fill: 'backwards' });

    // stelle: salgono dal basso una dopo l'altra (verso notte) o scendono (verso giorno)
    stars.forEach((s, i) => {
      const down = { opacity: 0, transform: 'translateY(10px)' }, up = { opacity: 1, transform: 'translateY(0)' };
      s.animate(toNight ? [down, up] : [up, down], {
        duration: toNight ? 500 : 300,
        delay: toNight ? 250 + i * 110 : i * 40,
        easing: toNight ? 'cubic-bezier(.2, .9, .3, 1.4)' : 'ease-in',
        fill: 'backwards',
      });
    });
  }

  document.addEventListener('themechange', (e) => {
    if (reduced.matches) return;
    const toNight = !(e as CustomEvent<{ light: boolean }>).detail.light;
    toggles.forEach((t) => play(t, toNight));
  });
</script>
