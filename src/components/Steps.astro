---
import { steps } from '../data/site.js';
---
<!-- Come funziona: una sola riga compatta -->
<section class="steps-bar alt">
  <div class="wrap">
    <p class="eyebrow">Come funziona</p>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="step-n">{i + 1}</span>
          <div><h3>{s.title}</h3><p>{s.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>
