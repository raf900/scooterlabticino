---
import { steps } from '../data/site.js';
---
<section class="section alt">
  <div class="wrap">
    <p class="eyebrow">Come funziona</p>
    <h2>Semplice, veloce, trasparente</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="step-n">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
