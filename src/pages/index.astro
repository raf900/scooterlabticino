---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import officina from '../assets/officina.webp';
import RepairDiagram from '../components/RepairDiagram.astro';
import ScooterCards from '../components/ScooterCards.astro';
import Steps from '../components/Steps.astro';
import Contacts from '../components/Contacts.astro';
import { wa } from '../data/site.js';
---
<Layout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Riparazioni e modifiche</p>
        <h1>Il tuo monopattino,<br /><span class="accent">di nuovo in strada.</span></h1>
        <p class="lead">Riparazioni rapide, manutenzione e monopattini usati controllati e garantiti. Tutte le marche: Xiaomi, Segway-Ninebot, Navee e altre.</p>
        <div class="cta-row">
          <a class="btn" href={wa('Ciao! Il mio monopattino ha bisogno di una riparazione.')}>Richiedi un preventivo</a>
          <a class="btn btn-ghost" href="/usato">Vedi l'usato</a>
        </div>
        <ul class="badges">
          <li>✓ Preventivo gratuito</li>
          <li>✓ Riparazioni in 1–3 giorni</li>
          <li>✓ Garanzia sugli interventi</li>
        </ul>
      </div>
      <div class="hero-art">
        <Image
          src={officina}
          alt="L'officina Scooter Lab: due tecnici al lavoro su un monopattino elettrico"
          widths={[480, 841]}
          sizes="(max-width: 900px) 100vw, 480px"
          loading="eager"
          fetchpriority="high"
          class="hero-photo"
        />
      </div>
    </div>
  </section>

  <section id="riparazioni" class="section">
    <div class="wrap">
      <p class="eyebrow">Riparazioni e manutenzione</p>
      <h2>Dove interveniamo</h2>
      <p class="sub">Tocca una parte del monopattino per vedere cosa ripariamo e quanto costa.</p>
      <RepairDiagram />
    </div>
  </section>

  <Steps />

  <section id="usato" class="section">
    <div class="wrap">
      <p class="eyebrow">Usato garantito</p>
      <h2>Monopattini di seconda mano</h2>
      <p class="sub">Ogni monopattino è revisionato nella nostra officina, testato su strada e venduto con 6 mesi di garanzia.</p>
      <ScooterCards onlyAvailable />
      <p class="note"><a href="/usato">Vedi tutto l'usato</a> · Vuoi vendere il tuo monopattino? <a href="/usato#vendi">Guarda quanto lo paghiamo</a>.</p>
    </div>
  </section>

  <section id="contatti" class="section alt">
    <div class="wrap">
      <Contacts />
    </div>
  </section>
</Layout>
