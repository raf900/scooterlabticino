---
import Layout from '../layouts/Layout.astro';
import Steps from '../components/Steps.astro';
import RepairPicker from '../components/RepairPicker.astro';
---
<Layout
  title="Riparazioni monopattini elettrici — Scooter Lab Ticino"
  description="Riparazione e manutenzione di monopattini elettrici in Ticino: ruote, freni, motore, batteria, elettronica e check-up completo. Prezzi chiari."
>
  <section class="section page-top">
    <div class="wrap">
      <p class="eyebrow">Riparazioni e manutenzione</p>
      <h1 class="page-title">Riparazioni</h1>
      <p class="sub">Scegli i ricambi che ti servono, guarda il totale indicativo e scrivici su WhatsApp. Preventivo gratuito prima di ogni intervento.</p>
      <RepairPicker />
    </div>
  </section>
  <Steps />
</Layout>
